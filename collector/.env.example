# collector/.env olarak kopyalayıp doldurun.
# (Paketlenmiş exe'de bu dosyayı elle hazırlamaya gerek yok: .env yoksa program
#  ilk açılışta sihirbazla sorar ve exe'nin yanına yazar — `--setup` ile tekrarlanır.)

# LoL kurulum dizini (içinde client açıkken 'lockfile' oluşur)
LOL_DIR=C:\Riot Games\League of Legends

# Backend adresi (sondaki / olmadan) ve paylaşılan API anahtarı
BACKEND_URL=http://127.0.0.1:8000
API_KEY=degistir-beni

# Opsiyonel:
# Arayüz dili / UI language (tr|en; boşsa ilk çalıştırmada sorulur, varsayılan tr)
#LANGUAGE=tr
# Backfill roster filtresi: maçın 10 katılımcısından en az kaçı bilinen oyuncu olmalı
#MIN_KNOWN=6
# Gameflow polling aralığı (saniye)
#POLL_INTERVAL_S=2.5
# Canlı modda açılışta otomatik yetişme penceresi (gün); 0 = kapalı
#CATCHUP_DAYS=14
