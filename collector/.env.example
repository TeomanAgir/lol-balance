# collector/.env olarak kopyalayıp doldurun

# LoL kurulum dizini (içinde client açıkken 'lockfile' oluşur)
LOL_DIR=C:\Riot Games\League of Legends

# Backend adresi (sondaki / olmadan) ve paylaşılan API anahtarı
BACKEND_URL=http://127.0.0.1:8000
API_KEY=degistir-beni

# Opsiyonel:
# Backfill roster filtresi: maçın 10 katılımcısından en az kaçı bilinen oyuncu olmalı
#MIN_KNOWN=6
# Gameflow polling aralığı (saniye)
#POLL_INTERVAL_S=2.5
