# backend/.env — kopyalayıp .env olarak kaydedin.

# Tüm /api/v1 isteklerinde beklenen X-API-Key değeri (zorunlu).
API_KEY=degistir-beni

# İdari uçların (void / unvoid / roulette unlink / POST-PATCH players /
# admin replay / admin ping) İKİNCİ anahtarı: bu uçlar X-API-Key'e EK olarak
# X-Admin-Key ister (api_contract "Admin anahtarı").
# Tanımlı değilse idari uçlar 503 döner (yüzey kapalı; uygulama normal çalışır).
# YALNIZ ASCII karakter kullanın (fix-3): HTTP header'ları latin-1 ile taşınır,
# Türkçe karakterli (ş, ğ, ı ...) bir anahtar doğru girilse bile doğrulanamaz —
# backend böyle bir anahtarda idari uçlarda 503 + açıklayıcı hata döner.
# Prod'da değer YALNIZ k8s secret'ında yaşar — repoya asla yazılmaz.
#ADMIN_KEY=degistir-beni-de

# SQLite dosya yolu (Docker'da volume'a denk gelir). Varsayılan: backend/data/lol_balance.db
#DB_PATH=./data/lol_balance.db

# Aktif rating engine versiyonu. Varsayılan: openskill-pl-blend30-s2-v1
#ENGINE_VERSION=openskill-pl-blend30-s2-v1

# Statik servis edilecek web UI dizini. Varsayılan: ../webui
#WEBUI_DIR=../webui
