+
+  deploy:
+    # Yeni image GHCR'a çıkınca VPS'teki deployment'ı restart eder (imagePullPolicy: Always
+    # yeni imajı çeker). Kimlik: dar yetkili ci-deployer SA — bkz. deploy/ci-rbac.yaml.
